import litellm
from pathlib import Path

from src.llm_client import load_llm_config, load_system_prompt

config = load_llm_config(Path("config.toml"))
system_prompt = load_system_prompt(
    Path("src/prompts/funny_tutor_em.txt")
)

user_prompt = r"""
请独立求解下面的问题，然后再验证题库已有答案。

题目：
一个半径为 1 mm 的雨滴，在竖直方向电场强度为 10^4 V/m 的雷雨云下不会下落。
已知 g=10 m/s²，水的密度为 10^3 kg/m³。
求雨滴携带的最小电荷量。

题库已有答案：
["D"]

重要要求：
1. 必须先独立求解。
2. 不得把 D 作为推理前提。
3. 得到自己的结论以后，再和题库答案比较。
4. 输出：
{
  "model_answer": ["..."],
  "verdict": "match 或 mismatch 或 uncertain",
  "explanation": "..."
}
5. 只输出 JSON。
"""

messages = [
    {"role": "system", "content": system_prompt},
    {
        "role": "user",
        "content": (
            "MODE: VERIFY\n"
            "Solve independently first; compare only after reaching your own conclusion. "
            "Do not use the provided answer as a reasoning premise.\n\n"
            + user_prompt
        ),
    },
]

print("MODEL:", config.model)
print("THINK:", False)

response = litellm.completion(
    model=config.model,
    api_base=config.api_base,
    messages=messages,
    think=False,
    timeout=180,
)

message = response.choices[0].message

print("\n=== MESSAGE OBJECT ===")
print(message)

print("\n=== MESSAGE DICT ===")
if hasattr(message, "model_dump"):
    print(message.model_dump())
elif hasattr(message, "dict"):
    print(message.dict())
else:
    print(vars(message))

print("\n=== CONTENT repr ===")
print(repr(message.content))

print("\n=== CONTENT ===")
print(message.content)

print("\n=== RESPONSE repr ===")
print(repr(response))
